%% ------------------------------------------------- SERIES-LEVEL SETTINGS
\newcommand\axschoolyear{%
  \ifnum\month>7 \the\year/\the\numexpr\year+1\relax
  \else \the\numexpr\year-1\relax/\the\year\fi}
\def\axs@title{}\def\axs@subtitle{}\def\axs@info{}\def\axs@bareme{}
\newcommand\axltr[1]{\ifaxar\textfrench{#1}\else#1\fi}
% banner text lives in a TikZ node (LTR by default): force RTL so Arabic words keep their reading order
\newcommand\axrtl[1]{\ifaxar\RL{#1}\else#1\fi}
\def\axs@author{Seifeddine TALBI}\def\axs@year{\axschoolyear}
\newif\ifaxcorr
\pgfkeys{/axm/.cd,
  title/.store in=\axs@title, subtitle/.store in=\axs@subtitle,
  info/.store in=\axs@info, bareme/.store in=\axs@bareme,
  author/.store in=\axs@author, year/.store in=\axs@year,
  serie/.code={\ifaxar\def\axs@subtitle{السلسلة عدد #1}\else\def\axs@subtitle{Série n°#1}\fi},
  sous-titre/.store in=\axs@subtitle,
  classe/.code={\def\axx@levellabel{#1}},
  corrige/.is if=axcorr, corrige/.default=true}
\newcommand\axsetup[1]{\pgfkeys{/axm/.cd,#1}}

%% ----------------------------------------------------- PAGE DECORATION
\ifaxmir\else
\AddToShipoutPictureBG{%
  \AtPageUpperLeft{\put(0,-\LenToUnit{8mm}){\color{axmain}\rule{\paperwidth}{8mm}}}%
  \AtPageLowerLeft{\put(\LenToUnit{9mm},\LenToUnit{.5\paperheight}){%
     \rotatebox{90}{\makebox[0pt]{\color{axmain!70!gray}\sffamily\large Axiomaths}}}}}
\fi
\renewcommand{\headrule}{\ifdim\headrulewidth>0pt{\color{axmain}\hrule width\headwidth height 1.2pt}\fi}
\definecolor{axlogobg}{HTML}{16130E}
% logo: file next to the .tex; without it the banner simply takes the full width
\newcommand\axlogofile{axiomaths-logo.png}
\newcommand\axlogo[1]{\IfFileExists{\axlogofile}{\includegraphics[#1]{\axlogofile}}{}}
\newcommand\axfoot{\fancyfoot[C]{\small\color{axgrey}\axlbl@page\ \thepage/\pageref{LastPage}}}
% pages 2+: small header (author/year | logo | level), page number in the footer
\newcommand\axapplyheader{%
  \pagestyle{fancy}\fancyhf{}\axfoot
  \fancyhead[C]{\axlogo{height=1.15cm}}%
  \fancyhead[L]{\small\begin{tabular}{@{}l @{\ }l@{}}%
      \textbf{\axlbl@author} & \axltr{\axs@author} \\
      \textbf{\axlbl@year} & \axs@year \end{tabular}}%
  \fancyhead[R]{\small\begin{tabular}{@{}l @{\ }r@{}}%
      \textbf{\axlbl@level} & \axx@levellabel \\
      \textbf{\axlbl@pages} & \pageref{LastPage} \\
      \ifx\axs@subtitle\@empty\else\multicolumn{2}{@{}r@{}}{\textbf{\axs@subtitle}}\fi \end{tabular}}}
% page 1: no header (the logo + banner are the header), same footer
\fancypagestyle{axfirst}{\fancyhf{}\axfoot\renewcommand{\headrulewidth}{0pt}}
\AtBeginDocument{\axapplyheader}

%% ---------------------------------------------------------- STARS / BADGES
\newcommand\axstar[1]{\tikz[baseline=-0.55ex]\node[star,star points=5,star point ratio=2.3,%
  inner sep=1.8pt,line width=0.3pt,draw=axgold!60!black,#1]{};}
\newcommand\axstars[1]{\foreach \axs in {1,2,3,4}{\ifnum\axs>#1 \axstar{fill=white}\else\axstar{fill=axgold}\fi\,}}
\newcommand\axbadge[3]{\tikz[baseline=(axb.base)]\node[fill=#1,text=#2,rounded corners=2pt,%
  inner xsep=5pt,inner ysep=2.4pt,font=\sffamily\bfseries\footnotesize](axb){#3};}

%% ------------------------------------------------ TITLE BLOCK + LEGEND
\newcommand\axlegend{\par\vspace{2pt}{\footnotesize\color{axgrey}\axlbl@legend\ %
  \axstars{1}\,\axlbl@l@one\quad \axstars{2}\,\axlbl@l@two\quad \axstars{3}\,\axlbl@l@three\quad \axstars{4}\,\axlbl@l@four\par}}
\newlength\axlogow \newlength\axgap
\newcommand\axbannertext{%
  \ifx\axs@subtitle\@empty\else{\sffamily\Huge\bfseries\axrtl{\axs@subtitle}}\par\vspace{1.5mm}\fi
  {\sffamily\Large\bfseries \axrtl{\axs@title}}\par
  \ifaxcorr\vspace{1mm}{\bfseries\large\axrtl{\axlbl@corrige}}\par\fi
  \ifx\axs@info\@empty\else\vspace{1mm}{\small\axrtl{\axs@info}}\par\fi}
% page 1, two stacked rows:
%   row 1 = logo (top-left corner) + "Proposé par / Année scolaire / Niveau" on its right
%   row 2 = full-width banner with "Série n°N" above the chapter name
% Both tikzpictures are exactly \textwidth wide, so the logo stays on the PHYSICAL
% left in Arabic (RTL) documents too.
\newcommand\axmaketitle{%
  \thispagestyle{axfirst}%
  \IfFileExists{\axlogofile}{\setlength\axlogow{1.9cm}\setlength\axgap{4mm}}%
                            {\setlength\axlogow{0pt}\setlength\axgap{0pt}}%
  \vspace*{-2.0cm}\noindent
  \begin{tikzpicture}[inner sep=0pt,outer sep=0pt]
    \IfFileExists{\axlogofile}{\node[anchor=north west](lg) at (0,0){\axlogo{height=1.7cm}};}%
      {\node[anchor=north west,minimum height=1.7cm](lg) at (0,0){};}
    \node[anchor=west,text width=\dimexpr\textwidth-\axlogow-\axgap\relax,align=justify]
      at ($(lg.east)+(\axgap,0)$){\footnotesize\color{axgrey}%
      \textbf{\axlbl@author}\ \axltr{\axs@author}\hfill\textbf{\axlbl@level}\ \axx@levellabel\par\smallskip
      \textbf{\axlbl@year}\ \axs@year\hfill\textbf{\axlbl@pages}\ \pageref{LastPage}\par};
  \end{tikzpicture}\par\vspace{2mm}\noindent
  \begin{tikzpicture}[inner sep=0pt,outer sep=0pt]
    \node[anchor=north west,fill=axmain,draw=axdark,line width=0.5mm,text=white,%
          text width=\dimexpr\textwidth-8mm-0.5mm\relax,align=center,%
          inner xsep=4mm,inner ysep=3mm,minimum height=2.3cm](ban) at (0,0){\axbannertext};
  \end{tikzpicture}\par\vspace{3pt}%
  \axlegend\vspace{4pt}}

%% ------------------------------------------- EXERCISE / CORRIGÉ ENVIRONMENTS
\newcounter{axexo}
\def\axx@tot{0}
\def\axresetmeta{\def\axe@stars{}\def\axe@pts{}\def\axe@year{}\def\axe@title{}%
  \def\axe@src{}\def\axe@id{}}
\axresetmeta
\pgfkeys{/axm/exo/.cd,
  stars/.store in=\axe@stars, pts/.store in=\axe@pts, year/.store in=\axe@year,
  title/.store in=\axe@title, source/.store in=\axe@src, id/.store in=\axe@id}
\newcommand\axaddpts{\ifx\axe@pts\@empty\else
  \pgfmathparse{\axx@tot+\axe@pts}\xdef\axx@tot{\pgfmathresult}\fi}

\newcommand\axexoheader[2]{%
  \ifx\axe@id\@empty\else{\ttfamily\footnotesize\color{axgrey}\#\axe@id}\quad\fi
  {\sffamily\bfseries\large\color{axdark}#1\ \theaxexo}%
  \ifx\axe@stars\@empty\else\quad\axstars{\axe@stars}\fi
  \ifx\axe@pts\@empty\else\quad\axbadge{axorange}{white}{\axe@pts\,\axlbl@pts}\fi
  \ifx\axe@year\@empty\else\quad\axbadge{axpurplelight}{axpurple}{\axe@year}\fi
  \ifx\axe@title\@empty\else\par\medskip{\sffamily\bfseries\large\color{black}\axe@title}\fi
  \ifx\axe@src\@empty\else\par{\sffamily\small\bfseries\color{axgrey}\axe@src}\fi}

\tcbset{axbox/.style={enhanced jigsaw,breakable,sharp corners,boxrule=0.6pt,
  colframe=axmain,colback=white,colbacktitle=axlight,coltitle=black,
  fonttitle=\normalfont,toptitle=2mm,bottomtitle=2mm,titlerule=0.5pt,
  left=2mm,right=2mm,top=2mm,bottom=2mm,before skip=9pt,after skip=9pt},
  axboxsol/.style={axbox,colframe=axdark,colback=axlight!40!white,colbacktitle=axmid}}

%% ------------------------------------------------------ CORRIGÉ : RAPPELS DE COURS
%%  \begin{prop}[Titre]...\end{prop}   boîte de rappel (théorème, propriété, définition) ; titre par défaut « Propriété »
%%  \ib{$formule$}                     formule clé encadrée, dans la ligne
\newtcolorbox{prop}[1][Propriété]{colback=axpurplelight, colframe=axpurple, boxrule=0.6pt, arc=2pt,
  left=6pt, right=6pt, top=4pt, bottom=4pt, before skip=8pt, after skip=8pt, breakable,
  before upper={\textcolor{axpurple}{\bfseries #1\,:}\ }}
\newcommand{\ib}[1]{\tcbox[on line, colback=axpurplelight, colframe=axpurple, boxrule=0.4pt, arc=1.5pt,
  boxsep=1.5pt, left=2pt, right=2pt, top=1pt, bottom=1pt]{#1}}

\NewDocumentEnvironment{exo}{O{}}{%
  \begingroup\axresetmeta\pgfkeys{/axm/exo/.cd,#1}%
  \refstepcounter{axexo}\axaddpts\axx@tocentry
  \begin{tcolorbox}[axbox,title={\axexoheader{\axlbl@exo}{}}]%
}{\end{tcolorbox}\endgroup}

%% corrigé: the statement is REPEATED, then \axsol opens the solution part.
%%   \begin{corr}[title=..., stars=.., ...]  statement  \axsol  solution  \end{corr}
\newif\ifaxmark
\newcommand\axsol{\tcblower\noindent{\sffamily\bfseries\color{axdark}\axlbl@sol\,:}\par\nobreak\smallskip\nobreak\@beginparpenalty=\@M\relax}
\NewDocumentEnvironment{corr}{O{}}{%
  \begingroup\axresetmeta\pgfkeys{/axm/exo/.cd,#1}\axmarktrue
  \refstepcounter{axexo}\axaddpts\axx@tocentry
  \begin{tcolorbox}[axbox,lowerbox=visible,colbacklower=axmid!35!white,collower=black,
    title={\axexoheader{\axlbl@exo}{}}]%
}{\end{tcolorbox}\endgroup}

%% ------------------------------------------------ QCM (4 choices, 1..4 correct)
\newcommand\axrag{\ifaxar\raggedleft\else\raggedright\fi}% ragged toward the reading end
\newenvironment{qcm}{\par\smallskip%
  \begin{enumerate}[label=\textbf{\axlbl@q\arabic*\axlbl@qsep},leftmargin=*,itemsep=8pt]}%
  {\end{enumerate}}
%% \qitem[AC]{question}{A}{B}{C}{D}: the optional list of correct letters is only
%% displayed inside a `corr` environment (ticked boxes in green); ignored in `exo`.
\newcommand\axchoice[3]{% #1 = letter key, #2 = printed label, #3 = text
  \leavevmode
  \ifaxmark
    \edef\axq@tmp{\noexpand\in@{#1}{\axq@keys}}\axq@tmp
    \ifin@ \textcolor{axgreen}{\textbf{$\blacksquare$\,#2)}}\,\textcolor{axgreen}{#3}\else $\square$\,#2) #3\fi
  \else $\square$\,#2) #3\fi}
\NewDocumentCommand\qitem{O{} m m m m m}{\def\axq@keys{#1}\item #2\par\nopagebreak\vspace{3pt}%
  {\renewcommand{\arraystretch}{1.2}%
   \begin{tabular}{@{}>{\axrag\arraybackslash}p{.46\linewidth}@{\hspace{2mm}}>{\axrag\arraybackslash}p{.46\linewidth}@{}}
   \axchoice{A}{\axlbl@A}{#3} & \axchoice{B}{\axlbl@B}{#4} \\
   \axchoice{C}{\axlbl@C}{#5} & \axchoice{D}{\axlbl@D}{#6} \end{tabular}}}
%% \axanswerkey{1/AC, 2/B, 3/ABD}  -> compact answer grid for the corrigé
\newcommand\axanswerkey[1]{\par\smallskip\begin{multicols}{4}\noindent
  \foreach \qn/\qa in {#1}{\textbf{\axlbl@q\qn}\,$\to$\,\textbf{\axltr{\qa}}\par}%
  \end{multicols}}

%% --------------------------------------------------- POINTS CHECK (log only)
\newcommand\axtotal{\pgfmathprintnumber[fixed]{\axx@tot}\,\axlbl@pts}
\AtEndDocument{\ifx\axs@bareme\@empty\else
  \pgfmathparse{abs(\axx@tot-\axs@bareme)>0.001}%
  \ifdim\pgfmathresult pt>0pt
    \PackageWarning{axiomath}{Sum of pts is \axx@tot\space but bareme=\axs@bareme}%
  \fi\fi}
%% ================================================ v2.3: RAPPELS, SOMMAIRE, FIGURES
%% \sommaire : mini table of contents of the exercises (title + difficulty), compile twice.
%% \begin{rappels} ... \end{rappels} : the course reminder that opens every série.
\ifaxar\def\axlbl@rappels{تذكير}\def\axlbl@sommaire{المحتوى}\else\def\axlbl@rappels{Rappels}\def\axlbl@sommaire{Sommaire}\fi
\newcommand\axx@tocentry{\begingroup
  \protected@edef\axx@w{\endgroup\noexpand\addtocontents{axt}{\noexpand\protect\noexpand\axtocline
    {\theaxexo}{\unexpanded\expandafter{\axe@title}}{\axe@stars}{\noexpand\thepage}}}\axx@w}
\newcommand\axtocline[4]{\par\noindent{\small\textbf{\axlbl@exo\ #1}\ifx\relax#2\relax\else\ -- #2\fi
  \ifx\relax#3\relax\else\ \axstars{#3}\fi\dotfill#4}\par}
\newcommand\sommaire{\par\noindent{\sffamily\bfseries\small\color{axdark}\axlbl@sommaire}\par\vspace{1pt}%
  {\color{axmain}\hrule height 0.4pt}\vspace{3pt}\@starttoc{axt}\vspace{4pt}}
\newenvironment{rappels}{\begin{tcolorbox}[axbox,colback=axlight!50!white,
  title={\sffamily\bfseries\color{axdark}\axlbl@rappels}]}{\end{tcolorbox}}
%% Figures (both renderings): the weight of a line says what it is (design skill §4b)
\tikzset{
  main/.style={line width=0.9pt}, thin/.style={line width=0.4pt},
  hidden/.style={line width=0.4pt, dash pattern=on 3pt off 2pt},
