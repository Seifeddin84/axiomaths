%% ----------------------------------------------------------------- FONTS
\IfFontExistsTF{Alegreya}{\setmainfont{Alegreya}}{%
  \IfFontExistsTF{TeX Gyre Pagella}{\setmainfont{TeX Gyre Pagella}}{}}
\ifaxar
  \setmainlanguage[numerals=maghrib]{arabic}
  \setotherlanguage{french}
  % serif Arabic (body): Amiri > Noto Naskh Arabic > FreeSerif > DejaVu Sans
  \IfFontExistsTF{Amiri}{\newfontfamily\arabicfont[Script=Arabic,Scale=1.1]{Amiri}\def\axar@fb{Amiri}}{%
  \IfFontExistsTF{Noto Naskh Arabic}{\newfontfamily\arabicfont[Script=Arabic]{Noto Naskh Arabic}\def\axar@fb{Noto Naskh Arabic}}{%
  \IfFontExistsTF{FreeSerif}{\newfontfamily\arabicfont[Script=Arabic]{FreeSerif}\def\axar@fb{FreeSerif}}{%
  \newfontfamily\arabicfont[Script=Arabic]{DejaVu Sans}\def\axar@fb{DejaVu Sans}}}}
  % "sans" Arabic: same family as the body font (it must also contain Latin letters,
  % digits and punctuation, which Noto Kufi / Noto Sans Arabic do not)
  \edef\axar@tmp{\noexpand\newfontfamily\noexpand\arabicfontsf[Script=Arabic]{\axar@fb}}\axar@tmp
  \IfFontExistsTF{DejaVu Sans Mono}{\newfontfamily\arabicfonttt[Script=Arabic]{DejaVu Sans Mono}}{}
\else
  \setmainlanguage{french}
\fi

