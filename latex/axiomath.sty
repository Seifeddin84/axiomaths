%% ============================================================================
%%  axiomath.sty  --  AxioMath series style for the Tunisian curriculum
%%  v2.1 (2026-11-16)      Compile with XeLaTeX or LuaLaTeX (NOT pdfLaTeX)
%%
%%  \usepackage[level=2sc]{axiomath}     % level decides colour + language
%%  \usepackage[level=2sc,color=16537E]{axiomath}   % same, colour overridden (HEX, no #)
%%  \axsetup{title={...}, serie=3, info={Durée : 1 h}, bareme=20, corrige}   % bareme: exams only
%%  \begin{exo}[stars=1..4, pts=3, year=2025, title={...}, source={...}] ... \end{exo}   % homework
%%  \begin{corr}[stars=.., pts=.., title={...}] statement \axsol solution \end{corr}     % corrigé
%%  \qitem[AC]{question}{A}{B}{C}{D}    % [AC] = correct letters, ticked only inside corr
%%  Stars: 1 application directe, 2 facile, 3 moyen, 4 difficile.   Series: no pts, no bareme.
%%
%%  \usepackage[level=1,mir]{axiomath}   % MIR rendering (lycée pilote): black, Literaturnaya, run-in
%%                                       % problems, same commands and same detailed corrigé (latex/MIR_MODE.md)
%%  \axmaketitle  \sommaire  \begin{rappels}...\end{rappels}   % every série opens with rappels + sommaire
%%  \axsetup{classe={1\textsuperscript{ère} année -- lycée pilote}}   % overrides the level label shown
%%
%%  Add a level in ONE line (colour = HTML hex, lang = fr | ar):
%%     \axdefinelevel{key}{label shown in header}{HEX}{lang}
%% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{axiomath}[2026/11/27 v2.3 AxioMath series style (+ mir option, rappels, sommaire)]

\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{axiomath}{pdfLaTeX is not supported}%
  {Compile with XeLaTeX or LuaLaTeX (needed for fonts and Arabic).}
\fi
\RequirePackage{xkeyval}
\RequirePackage{xparse}

%% ---------------------------------------------------------------- LEVEL TABLE
%% \axdefinelevel{key}{header label}{HEX colour}{language}
\newcommand\axdefinelevel[4]{%
  \expandafter\def\csname axlv@#1@label\endcsname{#2}%
  \expandafter\def\csname axlv@#1@col\endcsname{#3}%
  \expandafter\def\csname axlv@#1@lang\endcsname{#4}}

% --- collège (Arabic)
\axdefinelevel{7b}{7 أساسي}{0F766E}{ar}
\axdefinelevel{8b}{8 أساسي}{15803D}{ar}
\axdefinelevel{9b}{9 أساسي}{4D7C0F}{ar}
% --- lycée (French)
\axdefinelevel{1}    {1\textsuperscript{ère} année secondaire}      {2563EB}{fr}
\axdefinelevel{2sc}  {2\textsuperscript{ème} Sciences}              {16537E}{fr}
\axdefinelevel{2info}{2\textsuperscript{ème} Technologie de l'info} {0891B2}{fr}
\axdefinelevel{2eco} {2\textsuperscript{ème} Éco \& Services}       {DB2777}{fr}
\axdefinelevel{3m}   {3\textsuperscript{ème} Mathématiques}         {7C3AED}{fr}
\axdefinelevel{3sc}  {3\textsuperscript{ème} Sciences exp.}         {059669}{fr}
\axdefinelevel{3tech}{3\textsuperscript{ème} Sciences techniques}   {475569}{fr}
\axdefinelevel{3info}{3\textsuperscript{ème} Sciences de l'info}    {0E7490}{fr}
\axdefinelevel{3eco} {3\textsuperscript{ème} Éco \& Gestion}        {05B47F}{fr}
\axdefinelevel{4m}   {Bac Mathématiques}                            {991B1B}{fr}
\axdefinelevel{4sc}  {Bac Sciences exp.}                            {9D174D}{fr}
\axdefinelevel{4tech}{Bac Sciences techniques}                      {1E293B}{fr}
\axdefinelevel{4info}{Bac Sciences de l'info}                       {155E75}{fr}
\axdefinelevel{4eco} {Bac Éco \& Gestion}                           {92400E}{fr}

%% ------------------------------------------------------------------- OPTIONS
\def\axx@level{2sc}
\def\axx@langopt{}
\def\axx@colopt{}
\DeclareOptionX{level}{\def\axx@level{#1}}
\DeclareOptionX{color}{\def\axx@colopt{#1}}
\DeclareOptionX{lang}{\def\axx@langopt{#1}}
\newif\ifaxmir \axmirfalse
\DeclareOptionX{mir}[true]{\csname axmir#1\endcsname}
\ProcessOptionsX\relax

\@ifundefined{axlv@\axx@level @col}{%
  \PackageError{axiomath}{Unknown level `\axx@level'}%
  {Use \string\axdefinelevel{key}{label}{HEX}{lang} before \string\usepackage, or pick a known key.}%
  \axdefinelevel{\axx@level}{\axx@level}{444444}{fr}}{}
\edef\axx@col{\csname axlv@\axx@level @col\endcsname}
% optional override: \usepackage[level=2sc,color=16537E]{axiomath}  (HEX without #)
\ifx\axx@colopt\@empty\else\edef\axx@col{\axx@colopt}\fi
\def\axx@levellabel{\csname axlv@\axx@level @label\endcsname}
\newif\ifaxar
\edef\axx@lang{\ifx\axx@langopt\@empty\csname axlv@\axx@level @lang\endcsname\else\axx@langopt\fi}
\def\axx@tmp{ar}\ifx\axx@lang\axx@tmp\axartrue\else\axarfalse\fi

