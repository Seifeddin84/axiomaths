%% axiomath-mir.sty — the "Mir" rendering of AxioMath handouts (séries, devoirs, corrigés)
%% for strong pupils (lycée pilote): a page of a Mir Publishers problem book.
%%
%% SAME COMMANDS AS axiomath.sty, so switching is one word in the preamble:
%%     \usepackage[level=1p]{axiomath}      % coloured handout (default, every level)
%%     \usepackage[level=1p]{axiomath-mir}  % Mir handout (pilote)
%% Content (statements, solutions, boxes) never changes between the two: only the styling.
%%
%% Interface (identical to axiomath.sty):
%%   \axsetup{title={...}, corrige}           corrige = print the solutions
%%   \begin{corr}[title={...}, stars=N, source={...}] statement \axsol solution \end{corr}
%%   \begin{prop}[Title] ... \end{prop}       course reminder box (corrigé)
%%   \ib{...}  /  $\ib{...}$                  framed key result
%%   \begin{qcm} \qitem[AB]{q}{a}{b}{c}{d} \end{qcm}   and   \axanswerkey{1/AB, 2/B}
%%   \vect{AB}, \R \N \Z \Q \C
%% Added (both packages should have them, see MIR_MODE.md):
%%   \axsetup{..., classe={1\up{ère} année -- lycée pilote}, sous-titre={Série 3}}
%%   \begin{rappels} ... \end{rappels}       the reminder that opens every series
%%   \sommaire                               mini table of contents (compile twice)
%%
%% Style: Computer Modern for text and mathematics (one family, as in the Mir books), black ink only,
%% bold numbered problems with continuous numbering, an asterisk on hard problems (stars >= 3, as
%% Berman does), small-caps titles, thin rules. Corrigé: the boxes stay (the house rule: detailed
%% solutions with reminders and framed results for every level), drawn as thin black frames.
%% Figures: black, thin lines (see .claude/skills/axiomath-design §4b).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{axiomath-mir}[2026/11/27 AxioMath handouts, Mir rendering]

% level=..., color=... and any axiomath.sty option are accepted (colour is ignored: black ink)
\def\axmir@level{}
\DeclareOption*{%
  \edef\axmir@opt{\CurrentOption}%
  \expandafter\axmir@parseopt\axmir@opt==\@nil}
\def\axmir@parseopt#1=#2=#3\@nil{\def\axmir@key{#1}\def\axmir@lv{level}%
  \ifx\axmir@key\axmir@lv\def\axmir@level{#2}\fi}
\ProcessOptions\relax

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}               % Latin Modern = Computer Modern: text and maths match
\RequirePackage{amsmath,amssymb}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{calc,arrows.meta,patterns,angles,quotes}
\RequirePackage{enumitem}
\RequirePackage[a4paper,top=2.4cm,bottom=2.4cm,left=2.6cm,right=2.6cm,headsep=0.8cm]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage[most]{tcolorbox}
\RequirePackage{pgfkeys}
\RequirePackage{array}

% ---------- ink: everything black (figures written for the coloured package stay black) ----------
\colorlet{axmain}{black}\colorlet{axdark}{black}\colorlet{axlight}{white}
\tikzset{every picture/.style={line width=0.5pt, >={Stealth[length=2mm]}}}

% ---------- usual shortcuts (provided only if missing) ----------
\providecommand{\R}{\mathbb{R}}\providecommand{\N}{\mathbb{N}}\providecommand{\Z}{\mathbb{Z}}
\providecommand{\Q}{\mathbb{Q}}\providecommand{\C}{\mathbb{C}}
\providecommand{\vect}[1]{\overrightarrow{#1}}
\providecommand{\up}[1]{\textsuperscript{#1}}
\providecommand{\og}{«~}\providecommand{\fg}{~»}

% ---------- \axsetup ----------
\newif\ifaxcorrige \axcorrigefalse
\def\axmir@title{}\def\axmir@classe{}\def\axmir@subtitle{}
\pgfkeys{/axmir/.is family, /axmir,
  title/.store in=\axmir@title,
  classe/.store in=\axmir@classe,
  sous-titre/.store in=\axmir@subtitle,
  corrige/.code={\axcorrigetrue},
  .unknown/.code={}}
\newcommand{\axsetup}[1]{\pgfkeys{/axmir,#1}}

% ---------- page: running head in small italics, page number, no rule (as in the Mir books) ----------
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[C]{\small\itshape\axmir@title}
\fancyhead[R]{\small\thepage}
\fancypagestyle{axmirfirst}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\small\thepage}}
\setlength{\parindent}{1.2em}
\setlength{\parskip}{0pt}
\linespread{1.06}

% ---------- title block: small caps, centred, thin rules ----------
\AtBeginDocument{%
  \thispagestyle{axmirfirst}%
  \begin{center}
    {\small\scshape AxioMath\ifx\axmir@classe\@empty\else\ \textperiodcentered\ \axmir@classe\fi}\par\medskip
    {\Large\scshape \axmir@title}\par
    \ifx\axmir@subtitle\@empty\else\smallskip{\itshape\axmir@subtitle}\par\fi
    \ifaxcorrige\smallskip{\scshape Corrigé}\par\fi
  \end{center}
  \vspace{2pt}\noindent\rule{\textwidth}{0.4pt}\vspace{6pt}\par}

% ---------- sections: "15. Prismes et parallélépipèdes" ----------
\setcounter{secnumdepth}{1}
\titleformat{\section}{\normalfont\bfseries}{\thesection.}{0.5em}{}
\titlespacing*{\section}{0pt}{1.6ex plus .4ex}{0.8ex}
\renewcommand{\thesection}{\arabic{section}}

% ---------- mini table of contents ----------
\titlecontents{section}[1.6em]{\small}{\contentslabel{1.6em}}{}{\titlerule*[0.6pc]{.}\contentspage}
\newcommand{\sommaire}{%
  \begingroup\small\noindent{\scshape Sommaire}\par\vspace{2pt}
  \@starttoc{toc}\endgroup\par\vspace{2pt}}

% ---------- reminder that opens every series: unboxed, between thin rules ----------
\newenvironment{rappels}{\par\smallskip\noindent\rule{\textwidth}{0.4pt}\par\vspace{3pt}%
  \small\noindent\textbf{Rappels.}\ \ignorespaces}%
  {\par\vspace{3pt}\noindent\rule{\textwidth}{0.4pt}\par\medskip}

% ---------- problems: continuous bold numbering, asterisk on hard ones ----------
\newcounter{axexo}
\def\axmir@ctitle{}\def\axmir@source{}\def\axmir@stars{0}
\pgfkeys{/axcorr/.is family, /axcorr,
  title/.store in=\axmir@ctitle, source/.store in=\axmir@source,
  stars/.store in=\axmir@stars, .unknown/.code={}}
\setlist[enumerate,1]{label=\arabic*.,leftmargin=1.8em,itemsep=1pt,topsep=2pt}
\setlist[enumerate,2]{label=\alph*),leftmargin=1.6em,itemsep=0pt,topsep=1pt}
\setlist[enumerate,3]{label=\roman*),leftmargin=1.6em}
\setlist[itemize]{label=--,leftmargin=1.6em,itemsep=0pt,topsep=2pt}

\newenvironment{corr}[1][]{%
  \def\axmir@ctitle{}\def\axmir@source{}\def\axmir@stars{0}%
  \pgfkeys{/axcorr,#1}%
  \refstepcounter{axexo}%
  \par\addvspace{0.9ex}%
  \noindent\textbf{\theaxexo.\ifnum\axmir@stars>2 \rlap{$^{*}$}\fi}\enspace\ignorespaces}%
  {\par}

% \axsol: énoncé → everything up to \end{corr} is dropped; corrigé → "Solution." and the solution
\long\def\axmir@drop#1\end#2{\def\axmir@arg{#2}\def\axmir@corr{corr}%
  \ifx\axmir@arg\axmir@corr\expandafter\end\expandafter{\axmir@corr}\else\expandafter\axmir@drop\fi}
\newcommand{\axsol}{%
  \ifaxcorrige
    \par\smallskip\noindent{\itshape Solution%
      \ifx\axmir@ctitle\@empty\else\ (\axmir@ctitle)\fi.}\par\smallskip
  \else\expandafter\axmir@drop\fi}

% ---------- corrigé boxes: kept for every level, drawn in black ----------
\newtcolorbox{prop}[1][]{enhanced, breakable, sharp corners, boxrule=0.4pt,
  colback=white, colframe=black, colbacktitle=white, coltitle=black,
  left=6pt, right=6pt, top=3pt, bottom=3pt, toptitle=2pt, bottomtitle=2pt,
  titlerule=0.4pt, fonttitle=\normalfont,
  title={\textsc{Rappel}\if\relax\detokenize{#1}\relax\else.\ \textbf{#1}\fi},
  before skip=6pt, after skip=6pt}
\setlength{\fboxrule}{0.4pt}\setlength{\fboxsep}{3pt}
% \ib{$...$} (text or display maths, as in the handouts) and $\ib{...}$ both work
\newcommand{\ib}[1]{\relax\ifmmode\in@{$}{#1}\ifin@\fbox{#1}\else\boxed{#1}\fi\else\fbox{#1}\fi}

% ---------- multiple choice ----------
\newcounter{axq}
\newenvironment{qcm}{\setcounter{axq}{0}\par\smallskip}{\par\smallskip}
\newcommand{\qitem}[6][]{\stepcounter{axq}%
  \par\noindent(\arabic{axq})\ #2\par
  \noindent\hspace*{1.5em}\begin{tabular}{@{}*{4}{p{0.21\textwidth}}@{}}
    \textbf{A.}~#3 & \textbf{B.}~#4 & \textbf{C.}~#5 & \textbf{D.}~#6
  \end{tabular}\par\smallskip}
\newcommand{\axanswerkey}[1]{\par\noindent\textbf{Réponses.}\ \axmir@keys#1,\@nil,\par\smallskip}
\def\axmir@keys#1,{\def\axmir@tmp{#1}\def\axmir@stop{\@nil}%
  \ifx\axmir@tmp\axmir@stop\else\axmir@onekey#1\@end\ \expandafter\axmir@keys\fi}
\def\axmir@onekey#1/#2\@end{(#1)~#2;}

\endinput
